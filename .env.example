# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/skytrace).
# When omitted, SKYTRACE AI automatically uses the built-in persistent local JSON store (./data/skytrace.db.json).
MONGODB_URI=""

# JWT_SECRET: Secret key for signing authentication JWT tokens.
JWT_SECRET="change-this-to-a-strong-random-secret"

# PORT: Server port (must be 3000 in AI Studio preview).
PORT=3000
